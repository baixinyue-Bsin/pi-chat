# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/

# next.js
/.next/
/out/

# production
/build
/dist/

# packaged macOS runtime (the README remains tracked)
/desktop/node-runtime/*
!/desktop/node-runtime/README.md
/.cache/pi-chat-node/
/dist/mac-arm64/Pi Chat.app/Contents/Resources/node/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.factory
e2e_*.mjs
